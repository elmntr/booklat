          "id",
          "title",
          "language",
          "grade",
          "text",
          "source",
          "words"
        ],
        "title": "Passage",
        "type": "object"
      },
      "Session": {
        "properties": {
          "accuracy_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accuracy Pct"
          },
          "duration_s": {
            "default": 0,
            "title": "Duration S",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "learner_id": {
            "title": "Learner Id",
            "type": "string"
          },
          "level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level"
          },
